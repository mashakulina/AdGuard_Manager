#!/usr/bin/env xdg-open
[Desktop Entry]
Version=1.0
Type=Application
Name=Установить AdGuard VPN Manager
Comment=Скачать и установить AdGuard VPN Manager
Exec=bash -c "set -euo pipefail; for dependency in python3 mktemp timeout; do command -v \\"\\$dependency\\" >/dev/null 2>&1 || { echo \\"Не найдена команда: \\$dependency\\" >&2; exit 127; }; done; work=\\$(mktemp -d \\"\\${TMPDIR:-/tmp}/adguard-manager-launcher.XXXXXXXX\\"); cleanup() { result=\\$?; rm -rf -- \\"\\$work\\"; exit \\"\\$result\\"; }; trap cleanup EXIT; trap 'exit 130' INT; trap 'exit 143' TERM; archive=\\"\\$work/install_manager.tar.gz\\"; url=https://raw.githubusercontent.com/mashakulina/AdGuard_Manager/main/install_manager.tar.gz; echo \\"Скачивание установщика AdGuard VPN Manager…\\"; downloaded=false; code=127; if command -v curl >/dev/null 2>&1; then if (ulimit -f 10240; curl --fail --location --silent --show-error --connect-timeout 15 --max-time 120 --max-filesize 10485760 --output \\"\\$archive\\" \\"\\$url\\"); then downloaded=true; else code=\\$?; fi; fi; if [[ \\"\\$downloaded\\" == false ]] && command -v wget >/dev/null 2>&1; then if (ulimit -f 10240; timeout 120 wget -q --timeout=30 --tries=2 --max-redirect=10 -O \\"\\$archive\\" \\"\\$url\\"); then downloaded=true; else code=\\$?; fi; fi; if [[ \\"\\$downloaded\\" == false ]]; then echo \\"Не удалось скачать установщик (код \\$code). Проверьте соединение и повторите попытку.\\" >&2; exit \\"\\$code\\"; fi; echo \\"Проверка архива…\\"; python3 -I -c 'exec(\\"import os,sys,tarfile\\\\ntry:\\\\n    with tarfile.open(sys.argv[1], '\\"'\\"'r:gz'\\"'\\"') as archive:\\\\n        member = archive.next()\\\\n        if (member is None or member.name != '\\"'\\"'install_manager.sh'\\"'\\"' or not member.isfile()\\\\n                or member.issparse() or member.size > 1048576):\\\\n            raise ValueError('\\"'\\"'Неверный bootstrap архив'\\"'\\"')\\\\n        data = archive.extractfile(member).read(1048577)\\\\n        if len(data) != member.size or archive.next() is not None:\\\\n            raise ValueError('\\"'\\"'Лишние или повреждённые файлы в bootstrap архиве'\\"'\\"')\\\\n        with open(sys.argv[2], '\\"'\\"'xb'\\"'\\"') as output:\\\\n            output.write(data)\\\\n        os.chmod(sys.argv[2], 0o700)\\\\nexcept (OSError, ValueError, EOFError, tarfile.TarError) as error:\\\\n    print('\\"'\\"'Не удалось проверить архив установщика: '\\"'\\"' + str(error), file=sys.stderr)\\\\n    sys.exit(65)\\\\n\\")' \\"\\$archive\\" \\"\\$work/install_manager.sh\\"; echo \\"Запуск установки…\\"; bash \\"\\$work/install_manager.sh\\""
Icon=utilities-terminal
Terminal=true
Categories=Network;
